{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.bandit.hyprbind",
  "productName": "hyprbind",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "removeUnusedCommands": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "resources": [],
    "category": "Utility",
    "shortDescription": "Hyprbind – a lightweight Tauri app",
    "longDescription": "Hyprbind: a Tauri application for Wayland binding, built with React, Vite and Rust."
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "hyprbind",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}